  <ul>
    <li><a href="/pghero">Overview</a></li>
    <li><a href="/pghero/queries">Queries</a></li>
    <li><a href="/pghero/space">Space</a></li>
    <li><a href="/pghero/connections">Connections</a></li>
    <li><a href="/pghero/live_queries">Live Queries</a></li>
    <li><a href="/pghero/maintenance">Maintenance</a></li>
    <li><a href="/pghero/explain">Explain</a></li>
    <li><a href="/pghero/tune">Tune</a></li>
  </ul>
</div>
