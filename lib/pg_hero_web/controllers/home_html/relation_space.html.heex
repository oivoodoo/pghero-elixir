<div class="content">
  <h1>
    {@relation}
    <%= if @schema != "public" do %>
      <small>{@schema}</small>
    <% end %>
  </h1>

  <h1>Size</h1>
  <div id="chart-1" class="chart">Loading...</div>
  <script>
    new Chartkick.LineChart("chart-1", <%= js_value(@chart_data) %>, {colors: ["#5bc0de"], legend: false, min: null, bytes: true});
  </script>
</div>
