<div class="content">
  <h1>Maintenance</h1>

  <table class="table">
    <thead>
      <tr>
        <th>Table</th>
        <th class="width-20">Last Vacuum</th>
        <th class="width-20">Last Analyze</th>
        <%= if @show_dead_rows do %>
          <th class="width-20">Dead Rows</th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <%= for table <- @maintenance_info do %>
        <tr>
          <td>
            {table[:table]}
            <%= if table[:schema] != "public" do %>
              <span class="text-muted">{table[:schema]}</span>
            <% end %>
          </td>
          <td>
            <% vacuum_time = latest_time([table[:last_autovacuum], table[:last_vacuum]]) %>
            <%= if vacuum_time do %>
              <span title={inspect(vacuum_time)}>{time_ago_in_words(vacuum_time)} ago</span>
            <% else %>
              <span class="text-muted">Unknown</span>
            <% end %>
          </td>
          <td>
            <% analyze_time = latest_time([table[:last_autoanalyze], table[:last_analyze]]) %>
            <%= if analyze_time do %>
              <span title={inspect(analyze_time)}>{time_ago_in_words(analyze_time)} ago</span>
            <% else %>
              <span class="text-muted">Unknown</span>
            <% end %>
          </td>
          <%= if @show_dead_rows do %>
            <td>
              <%= if table[:live_rows] not in [0, nil] do %>
                {round(100.0 * (table[:dead_rows] || 0) / table[:live_rows])}%
              <% else %>
                <span class="text-muted">Unknown</span>
              <% end %>
            </td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
