<div class="content">
  <h1>Space</h1>

  <p>Database Size: {@database_size}</p>

  <%= if @unused_indexes != [] do %>
    <p>
      {pluralize(length(@unused_indexes), "unused index", "unused indexes")}{if PgHero.Database.unused_index_bytes(
                                                                                  @database
                                                                                ) > 0,
                                                                                do:
                                                                                  " over #{PgHero.Pretty.size(PgHero.Database.unused_index_bytes(@database))}"}.
      Remove them for faster writes.
    </p>
  <% else %>
    <p>
      No unused indexes{if PgHero.Database.unused_index_bytes(@database) > 0,
        do: " over #{PgHero.Pretty.size(PgHero.Database.unused_index_bytes(@database))}"}
    </p>
  <% end %>

  <%= if @sizes_timeout do %>
    <p>Breakdown not available (system catalog locked)</p>
  <% else %>
    <table class="table space-table">
      <thead>
        <tr>
          <th>
            <a href={pg_path(@conn, "space", Map.merge(@header_options, %{"sort" => "name"}))}>
              {if @only_tables, do: "Table", else: "Relation"}
            </a>
          </th>
          <th class="width-15">
            <a href={pg_path(@conn, "space", @header_options)}>Size</a>
          </th>
          <%= if @space_stats_enabled do %>
            <th class="width-15">
              <a href={pg_path(@conn, "space", Map.merge(@header_options, %{"sort" => "growth"}))}>
                {@days}d Growth
              </a>
            </th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <%= for query <- @relation_sizes do %>
          <tr>
            <td class={if query[:type] == "index", do: "space-index"}>
              <span class="break-all">
                <% name = query[:relation] || query[:table] %>
                <%= if @space_stats_enabled do %>
                  <a
                    href={pg_path(@conn, ["space", name], %{schema: query[:schema]})}
                    target="_blank"
                    class="relation-link"
                  >
                    {name}
                  </a>
                <% else %>
                  {name}
                <% end %>
              </span>
              <%= if query[:schema] != "public" do %>
                <span class="text-muted">{query[:schema]}</span>
              <% end %>
              <%= if MapSet.member?(@unused_index_names, query[:relation]) do %>
                <span class="unused-index">UNUSED</span>
              <% end %>
            </td>
            <td>{query[:size]}</td>
            <%= if @space_stats_enabled do %>
              <td>
                <%= case @growth_bytes_by_relation[{query[:schema], query[:relation]}] do %>
                  <% nil -> %>
                    <span class="text-muted">Unknown</span>
                  <% growth -> %>
                    {if growth < 0, do: "-"}{PgHero.Pretty.size(abs(growth))}
                <% end %>
              </td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
