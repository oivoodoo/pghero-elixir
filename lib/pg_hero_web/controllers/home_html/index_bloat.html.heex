<div class="content">
  <h1>Index Bloat</h1>

  <%= if @index_bloat != [] do %>
    <p>
      Indexes can become <a
        href="https://www.compose.com/articles/postgresql-bloat-origins-monitoring-and-managing/"
        target="_blank"
      >
        bloated over time
      </a>. Recreate them to remove bloat.
    </p>

    <p>
      <%= if @show_sql do %>
        <a href={pg_path(@conn, "index_bloat")}>Hide SQL</a>
      <% else %>
        <a href={pg_path(@conn, "index_bloat", %{sql: "t"})}>Show SQL</a>
      <% end %>
      for each index
    </p>

    <table class="table">
      <thead>
        <tr>
          <th>Index</th>
          <th class="width-15">Bloat</th>
          <th class="width-15">Size</th>
        </tr>
      </thead>
      <tbody>
        <%= for index <- @index_bloat do %>
          <tr>
            <td>
              <span class="break-all">{index[:index]}</span>
              <%= if index[:primary] do %>
                <span class="primary-key">PRIMARY</span>
              <% end %>
            </td>
            <td>{PgHero.Pretty.size(index[:bloat_bytes])}</td>
            <td>{PgHero.Pretty.size(index[:index_bytes])}</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p>No significant index bloat!</p>
  <% end %>
</div>
