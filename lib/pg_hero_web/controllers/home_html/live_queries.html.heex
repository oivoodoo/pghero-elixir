<div class="content">
  <h1>Live Queries</h1>
  <p>{pluralize(length(@running_queries), "query")}</p>

  <%= if @running_queries != [] do %>
    <.live_queries_table
      conn={@conn}
      queries={@running_queries}
      vacuum_progress={@vacuum_progress}
      kill_enabled={@kill_enabled}
      explain_enabled={@explain_enabled}
    />

    <%= if @kill_enabled do %>
      <p>
        <form action={pg_path(@conn, "kill_all")} method="post">
          <input :if={token = csrf_token(@conn)} type="hidden" name="_csrf_token" value={token} />
          <button class="btn btn-danger" type="submit">Kill all connections</button>
        </form>
      </p>
      <p class="text-muted">You may need to restart your app servers afterwards.</p>
    <% end %>
  <% end %>
</div>
